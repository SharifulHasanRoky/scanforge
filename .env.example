# Copy this file to .env and fill in real values.

# PostgreSQL database URL (Prisma).
# For local dev:  postgresql://user:pass@localhost:5432/scanforge
# For Vercel deploy: use a free serverless Postgres from Neon (https://neon.tech)
#   Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/scanforge?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/scanforge"

# Random secret used to sign session cookies — generate a long random string.
# Example: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret"

# Public site URL (used for SEO metadata / canonical URLs)
NEXT_PUBLIC_SITE_URL="https://scanforge.app"
